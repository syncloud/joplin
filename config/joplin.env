NODE_ENV=production
NODE_EXTRA_CA_CERTS=/var/snap/platform/current/syncloud.ca.crt
APP_BASE_URL={{ .AppUrl }}
APP_SOCKET={{ .DataDir }}/joplin.sock
DB_CLIENT=sqlite3
SQLITE_DATABASE={{ .DataDir }}/joplin.sqlite
MAX_TIME_DRIFT=0
LOCAL_AUTH_ENABLED=false
OIDC_ENABLED=true
OIDC_ISSUER_URL={{ .AuthUrl }}
OIDC_ISSUER_SOCKET={{ .AuthSocket }}
OIDC_CLIENT_ID=joplin
OIDC_CLIENT_SECRET={{ .ClientSecret }}
OIDC_ADMIN_GROUP=syncloud
OIDC_ORGANIZATION_DISPLAY_NAME=Syncloud
